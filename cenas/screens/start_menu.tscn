[sub_resource type="Shader" id="living"]
code = "shader_type canvas_item;
void fragment(){
 vec4 c=texture(TEXTURE,UV);
 float water=smoothstep(0.70,0.83,UV.y)*smoothstep(0.08,0.30,c.g-c.r);
 vec2 shift=vec2(sin(UV.y*240.0+TIME*2.8)*0.0018,0.0);
 c=mix(c,texture(TEXTURE,UV+shift),water);
 float blue=smoothstep(0.25,0.65,c.b-c.r)*smoothstep(0.24,0.5,c.g)*smoothstep(0.12,0.3,UV.y);
 c.rgb+=vec3(0.02,0.10,0.13)*blue*(0.5+0.5*sin(TIME*3.3-UV.x*30.0));
 COLOR=c;
}"

[sub_resource type="ShaderMaterial" id="water"]
shader = SubResource("living")

[sub_resource type="Gradient" id="fade"]
colors = PackedColorArray(0.02, 0.04, 0.08, 0, 0.02, 0.04, 0.08, 0.75)

[sub_resource type="GradientTexture2D" id="shade"]
gradient = SubResource("fade")
fill_to = Vector2(0, 1)

[sub_resource type="Shader" id="glint"]
code = "shader_type canvas_item;
void fragment(){
 vec4 c=texture(TEXTURE,UV);
 float d=abs(UV.x+0.16*UV.y-(mod(TIME,5.8)*1.1-0.22));
 c.rgb+=vec3(0.32,0.27,0.15)*(1.0-smoothstep(0.0,0.06,d))*smoothstep(0.12,0.6,c.r);
 COLOR=c;
}"

